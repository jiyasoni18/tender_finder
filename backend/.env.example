# Copy to `.env` and fill in. Load it before running, e.g.:
#   set -a; source .env; set +a; python main.py

# ---- Site toggles ---------------------------------------------------------
ENABLE_MOCK_SITE=true      # offline demo site; set false once real sites work
ENABLE_IREPS=false
ENABLE_GEM=false

# ---- Site credentials -----------------------------------------------------
IREPS_USER=
IREPS_PASS=
GEM_USER=
GEM_PASS=

# ---- Lark delivery --------------------------------------------------------
# mode: noop | webhook | bot
LARK_MODE=noop

# bot mode (publish as a real Lark app)
LARK_APP_ID= 
LARK_APP_SECRET=
LARK_RECEIVE_ID=            # chat id (oc_...) the bot is a member of
LARK_RECEIVE_ID_TYPE=chat_id
LARK_API_BASE=https://open.larksuite.com   # use https://open.feishu.cn for Feishu

# Bitable integration
LARK_BITABLE_APP_TOKEN=
LARK_BITABLE_TABLE_ID=

# webhook mode
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=

# ---- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
MAX_DOWNLOADS=3

TENDERDETAIL_USER=
TENDERDETAIL_PASS=
